# Puerto donde escuchará la API Express
PORT=3001
# Configuración de conexión a PostgreSQL (usa el contenedor Docker existente)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ferreteria
DB_USER=ferreteria
DB_PASSWORD=cambia_esta_clave
# Servicio web externo de códigos postales (sin token). Consulta real: /api/codigos-postales/77500
POSTAL_API_BASE=https://postali.app
# Secreto para firmar el token de sesión (cambiar en producción)
SESSION_SECRET=cambia_esta_clave
