# Puerto donde escuchará la API Express
PORT=3001
# Configuración de conexión a PostgreSQL (usa el contenedor Docker existente)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ferreteria
DB_USER=ferreteria
DB_PASSWORD=cambia_esta_clave
# Token gratuito de Banxico SIE para el tipo de cambio (https://www.banxico.org.mx/SieAPIRest/service/v1/token)
# Si no se configura, la API responde un aviso controlado (no se cae).
BANXICO_TOKEN=
